function createHieroglyphTexture(god){
  const canvas=document.createElement('canvas');
  canvas.width=1024;canvas.height=128;
  const ctx=canvas.getContext('2d');
  const themes={
    ra:{bg:'#e8d4a8',border:'#facc15',ink:'#5c3a1a',accent:'#d97706'},
    isis:{bg:'#e8eef5',border:'#0d9488',ink:'#1e3a5f',accent:'#2dd4bf'},
    set:{bg:'#c48a5e',border:'#b91c1c',ink:'#3f1a0a',accent:'#ea580c'}
  };
  const t=themes[god];
  ctx.fillStyle=t.bg;ctx.fillRect(0,0,1024,128);
  ctx.fillStyle=t.border;ctx.fillRect(0,0,1024,9);ctx.fillRect(0,119,1024,9);
  ctx.strokeStyle=t.accent;ctx.lineWidth=1.8;
  ctx.beginPath();ctx.moveTo(0,16);ctx.lineTo(1024,16);ctx.moveTo(0,112);ctx.lineTo(1024,112);ctx.stroke();

  const symbols=god==='ra'?['sun','scarab','eye','falcon','ankh','was','shen','cartouche']:
               god==='isis'?['ankh','tjet','wings','throne','lotus','cobra','ankh','tjet']:
               ['setAnimal','was','shield','arrow','power','setAnimal','was','shield'];

  let x=28;
  while(x<990){
    const sym=symbols[Math.floor(Math.random()*symbols.length)];
    drawHieroglyph(ctx,sym,x,64,t.ink,t.accent);
    x+=30+Math.random()*20;
  }
  const tex=new T.CanvasTexture(canvas);
  tex.wrapS=T.RepeatWrapping;tex.wrapT=T.ClampToEdgeWrapping;
  tex.repeat.set(2.5,1);tex.colorSpace=T.SRGBColorSpace;
  return tex;
}

function drawHieroglyph(ctx,type,x,y,ink,accent){
  ctx.save();ctx.translate(x,y);ctx.fillStyle=ink;ctx.strokeStyle=ink;ctx.lineWidth=2.1;ctx.lineCap='round';
  switch(type){
    case'sun':
      ctx.beginPath();ctx.arc(0,0,10,0,Math.PI*2);ctx.fill();
      for(let i=0;i<8;i++){const a=i/8*Math.PI*2;ctx.beginPath();ctx.moveTo(Math.cos(a)*12,Math.sin(a)*12);ctx.lineTo(Math.cos(a)*17,Math.sin(a)*17);ctx.stroke();}
      break;
    case'scarab':
      ctx.beginPath();ctx.ellipse(0,0,8,11,0,0,Math.PI*2);ctx.fill();
      ctx.beginPath();ctx.ellipse(-9,-2,6,4.5,-.4,0,Math.PI*2);ctx.ellipse(9,-2,6,4.5,.4,0,Math.PI*2);ctx.fill();
      break;
    case'eye':
      ctx.beginPath();ctx.moveTo(-13,0);ctx.quadraticCurveTo(0,-11,13,0);ctx.quadraticCurveTo(0,11,-13,0);ctx.fill();
      ctx.fillStyle=accent;ctx.beginPath();ctx.arc(2,0,3.5,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle=ink;ctx.beginPath();ctx.moveTo(-11,-7);ctx.quadraticCurveTo(0,-13,11,-5);ctx.stroke();
      break;
    case'falcon':
      ctx.beginPath();ctx.moveTo(-7,7);ctx.lineTo(0,-11);ctx.lineTo(7,7);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.ellipse(5,0,9,4.5,.55,0,Math.PI*2);ctx.fill();
      break;
    case'shen':
      ctx.beginPath();ctx.arc(0,0,10,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.moveTo(10,0);ctx.lineTo(15,0);ctx.stroke();
      break;
    case'cartouche':
      ctx.beginPath();ctx.roundRect(-15,-8,30,16,8);ctx.stroke();
      ctx.beginPath();ctx.moveTo(-15,8);ctx.lineTo(15,8);ctx.stroke();
      break;
    case'ankh':
      ctx.beginPath();ctx.arc(0,-7,5.5,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.moveTo(0,-1.5);ctx.lineTo(0,13);ctx.moveTo(-8,3.5);ctx.lineTo(8,3.5);ctx.stroke();
      break;
    case'tjet':
      ctx.beginPath();ctx.moveTo(0,-11);ctx.lineTo(0,11);ctx.moveTo(-6,-3);ctx.lineTo(6,-3);ctx.moveTo(-4.5,3);ctx.lineTo(4.5,3);ctx.stroke();
      ctx.beginPath();ctx.arc(-4.5,-7,3.5,0,Math.PI*2);ctx.arc(4.5,-7,3.5,0,Math.PI*2);ctx.stroke();
      break;
    case'wings':
      ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo(-16,-9,-20,2);ctx.quadraticCurveTo(-9,5,0,0);ctx.fill();
      ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo(16,-9,20,2);ctx.quadraticCurveTo(9,5,0,0);ctx.fill();
      break;
    case'throne':
      ctx.fillRect(-7,-3,14,11);ctx.fillRect(-9,8,18,3.5);
      break;
    case'lotus':
      ctx.beginPath();ctx.moveTo(0,9);ctx.quadraticCurveTo(-9,-1,0,-11);ctx.quadraticCurveTo(9,-1,0,9);ctx.fill();
      ctx.beginPath();ctx.ellipse(-6,0,4.5,7,-.5,0,Math.PI*2);ctx.ellipse(6,0,4.5,7,.5,0,Math.PI*2);ctx.fill();
      break;
    case'cobra':
      ctx.beginPath();ctx.moveTo(0,11);ctx.quadraticCurveTo(-5,0,0,-9);ctx.quadraticCurveTo(5,0,0,11);ctx.fill();
      ctx.beginPath();ctx.arc(0,-11,3.5,0,Math.PI*2);ctx.fill();
      break;
    case'setAnimal':
      ctx.beginPath();ctx.moveTo(-5,7);ctx.lineTo(-3.5,-5);ctx.lineTo(0,-13);ctx.lineTo(3.5,-5);ctx.lineTo(5,7);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(-3.5,-5);ctx.lineTo(-8,-15);ctx.lineTo(-1.5,-7);ctx.fill();
      ctx.beginPath();ctx.moveTo(3.5,-5);ctx.lineTo(8,-15);ctx.lineTo(1.5,-7);ctx.fill();
      break;
    case'was':
      ctx.beginPath();ctx.moveTo(0,-13);ctx.lineTo(0,11);ctx.stroke();
      ctx.beginPath();ctx.moveTo(-4.5,-13);ctx.lineTo(0,-19);ctx.lineTo(4.5,-13);ctx.fill();
      ctx.beginPath();ctx.moveTo(-3.5,11);ctx.lineTo(0,7);ctx.lineTo(3.5,11);ctx.stroke();
