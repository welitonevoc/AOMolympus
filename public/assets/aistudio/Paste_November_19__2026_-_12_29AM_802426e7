function G(p,x=0,y=0,z=0){const g=new T.Group();g.position.set(x,y,z);if(p)p.add(g);return g;}
function B(p,w,h,d,m,pos=[0,0,0],rot=[0,0,0]){
  const mesh=new T.Mesh(new T.BoxGeometry(w,h,d),m);
