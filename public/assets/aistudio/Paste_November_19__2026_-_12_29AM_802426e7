function guardian(parent,statue,trim,gold,pos,scale,god){
  const st=G(parent,...pos);st.scale.setScalar(scale);
  B(st,.7,.34,.7,statue,[0,.17,0]);B(st,.76,.07,.76,trim,[0,.36,0]);B(st,.72,.05,.72,gold,[0,.42,0]);
  const fig=G(st,0,.44,0);
  C(fig,.075,.06,.55,10,statue,[-.1,.28,.05],[-.08,0,0]);C(fig,.075,.06,.55,10,statue,[.1,.28,-.04],[.06,0,0]);
  C(fig,.16,.2,.34,12,trim,[0,.58,0]);B(fig,.34,.06,.24,gold,[0,.74,0]);B(fig,.38,.42,.22,statue,[0,.96,0]);
  C(fig,.18,.2,.08,12,gold,[0,1.14,0]);
  const head=new T.Mesh(new T.SphereGeometry(.125,14,14),statue);head.position.set(0,1.3,.02);fig.add(head);
