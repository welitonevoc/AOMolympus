  const rxB=w*.5,rzB=d*.5,rxT=wT*.5,rzT=dT*.5;
  const geo=new T.BufferGeometry();
  const v=new Float32Array([
    -rxB,0,rzB,rxB,0,rzB,rxT,h,rzT,-rxB,0,rzB,rxT,h,rzT,-rxT,h,rzT,
    rxB,0,-rzB,-rxB,0,-rzB,-rxT,h,-rzT,rxB,0,-rzB,-rxT,h,-rzT,rxT,h,-rzT,
    -rxB,0,-rzB,-rxB,0,rzB,-rxT,h,rzT,-rxB,0,-rzB,-rxT,h,rzT,-rxT,h,-rzT,
    rxB,0,rzB,rxB,0,-rzB,rxT,h,-rzT,rxB,0,rzB,rxT,h,-rzT,rxT,h,rzT,
    -rxT,h,rzT,rxT,h,rzT,rxT,h,-rzT,-rxT,h,rzT,rxT,h,-rzT,-rxT,h,-rzT
  ]);
  const uv=new Float32Array(60);for(let i=0;i<30;i++){uv[i*2]=(v[i*3]+rxB)/w;uv[i*2+1]=v[i*3+1]/h;}
  geo.setAttribute('position',new T.BufferAttribute(v,3));geo.setAttribute('uv',new T.BufferAttribute(uv,2));geo.computeVertexNormals();
  const body=new T.Mesh(geo,stone);body.castShadow=body.receiveShadow=true;p.add(body);
  B(p,wT+.2,.13,dT+.2,stone,[0,h+.04,0]);
  B(p,wT+.24,.07,dT+.24,trim,[0,h+.12,0]);
  B(p,wT+.08,.045,dT+.08,gold,[0,h+.17,0]);
  if(vents){const dark=new T.MeshStandardMaterial({color:0x1a1410,roughness:.9});
    const n=Math.max(2,Math.floor(wT/.5));
    for(let i=0;i<n;i++){const vx=-wT*.32+(n===1?0:(i/(n-1))*wT*.64);
      B(p,.14,.17,.05,dark,[vx,h-.32,rzT+.01]);B(p,.14,.17,.05,dark,[vx,h-.32,-rzT-.01]);}}
  return p;
}
function wingedSun(parent,gold,trim,pos,scale=1,god='ra'){
  const g=G(parent,...pos);g.scale.setScalar(scale*(god==='ra'?1.15:1));
  const disk=new T.Mesh(new T.SphereGeometry(.14,16,16),gold);disk.scale.set(1,1,.4);g.add(disk);
  for(const s of[-1,1]){B(g,.48,.11,.04,gold,[s*.32,.02,0],[0,0,s*.09]);B(g,.40,.05,.045,trim,[s*.30,-.03,.01],[0,0,s*.09]);B(g,.22,.035,.03,gold,[s*.42,.01,0],[0,0,s*.15]);}
  if(god==='ra')B(g,.04,.12,.04,gold,[0,.18,0]);
