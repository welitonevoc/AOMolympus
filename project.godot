; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Age of Mythology: Olympus (Android)"
config/description="RTS mitologico 3D nativo em Godot 4 para celulares e tablets Android (Fases 1 a 4)."
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

OlympusUnitCatalog="*res://scripts/autoload/olympus_unit_catalog.gd"
PantheonCatalog="*res://scripts/autoload/pantheon_catalog.gd"
ModelLibrary="*res://scripts/autoload/model_library.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveLoadSystem="*res://scripts/autoload/save_load_system.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
MultiplayerManager="*res://scripts/network/multiplayer_manager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/gamedev_ai/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg")

[gui]

theme/custom="res://themes/rts_fantasy_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="units"
3d_physics/layer_2="resources"
3d_physics/layer_3="buildings"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
