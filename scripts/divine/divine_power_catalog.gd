const PANTHEON_POWERS: Dictionary = {
	"greek": ["lightning", "restoration", "prosperity", "lightning_storm"],
	"egyptian": ["rain", "locust_swarm", "sandstorm", "meteor"],
	"norse": ["healing", "frost", "flaming_weapons", "tremor"],
	"atlantean": ["sentinel", "spiders", "chaos", "black_hole"],
	"chinese": ["create_gold", "solar_beam", "maelstrom", "volcanic_eruption"]
}


static func get_power(power_id: String) -> Dictionary:
	return POWERS.get(power_id, POWERS["prosperity"])


static func get_pantheon_power_ids(pantheon_id: String) -> Array[String]:
	var list: Array = PANTHEON_POWERS.get(pantheon_id, PANTHEON_POWERS["greek"])
	var res: Array[String] = []
	for p in list:
		res.append(String(p))
	return res
