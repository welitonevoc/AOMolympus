static func get_power(power_id: String) -> Dictionary:
	return POWERS.get(power_id, {})

## Retorna IDs de poderes específicos de um Panteão (sem poluir com poderes neutros de campanha)
static func get_pantheon_power_ids(pantheon: String) -> Array[String]:
	var res: Array[String] = []
	var p_target := pantheon.to_lower().strip_edges()
	for pid in POWERS.keys():
		var p: Dictionary = POWERS[pid]
		if p["pantheon"] == p_target:
			res.append(pid)
	return res

## Retorna poderes de um Panteão disponíveis até a Era especificada (ordenados por Era)
static func get_powers_for_pantheon_and_age(pantheon: String, age: int) -> Array[Dictionary]:
	var res: Array[Dictionary] = []
	var p_target := pantheon.to_lower().strip_edges()
	for pid in POWERS.keys():
		var p: Dictionary = POWERS[pid]
		if p["pantheon"] == p_target and int(p["min_age"]) <= age:
			res.append(p)
	res.sort_custom(func(a, b): return int(a["min_age"]) < int(b["min_age"]))
	return res

## Retorna o conjunto representativo canônico (4 poderes, 1 por Era) para o HUD mobile
static func get_canonical_hud_powers(pantheon: String) -> Array[String]:
	match pantheon.to_lower().strip_edges():
		"greek":
			return ["bolt", "restoration", "bronze", "earthquake"]
		"egyptian":
			return ["rain", "prosperity", "eclipse", "meteor"]
		"norse":
			return ["great_hunt", "healing_spring", "flaming_weapons", "ragnorok"]
		"atlantean":
			return ["tremor", "audrey", "chaos", "vortex"]
		"chinese":
			return ["earth_dragon", "alchemy_fire", "tai_chi_shield", "celestial_dragon"]
		_:
			return ["bolt", "restoration", "bronze", "earthquake"]

