static func get_preset(preset_id: String) -> Dictionary:
	return PRESETS.get(preset_id, PRESETS["cidadela_do_olimpo"])


static func get_all_presets() -> Array[Dictionary]:
	var list: Array[Dictionary] = []
	for pid in PRESET_ORDER:
		if PRESETS.has(pid):
			list.append(PRESETS[pid])
	return list


static func get_presets_by_pantheon(pantheon_id: String) -> Array[Dictionary]:
	var list: Array[Dictionary] = []
	for pid in PRESET_ORDER:
		if PRESETS.has(pid):
			var spec: Dictionary = PRESETS[pid]
			if String(spec.get("pantheon_division", "")) == pantheon_id:
				list.append(spec)
	return list


static func get_default_preset_id() -> String:
	return "cidadela_do_olimpo"
