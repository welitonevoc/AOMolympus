[node name="GuideText" type="Label" parent="CanvasLayer/CenterContainer/MenuPanel/Margin/VBoxContainer/LearnMenu/ScrollGuide"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "• Economia: Aldeões coletam Alimento, Madeira e Ouro. O Centro Urbano é o ponto de entrega.

• Combate: Construa o Quartel Militar com seus aldeões para treinar Hoplitas e Hipaspistas.

• Poderes Divinos: Acumule Favor rezando no Templo para invocar o Raio de Zeus na Central de Comandos.

• Câmera: No mobile, use pinça com 2 dedos para zoom in/out e deslize com 1 dedo para navegar pelo mapa."
autowrap_mode = 2

